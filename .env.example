# Copy to .env and fill in. Never commit .env.

# --- Kalshi (only needed for demo/live trading and the WebSocket feed; record mode uses public endpoints) ---
# Demo and production keys are separate. Keys may be Ed25519 (Kalshi UI default) or RSA; the type is detected from the key file.
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=./secrets/kalshi-demo.key
KALSHI_PROD_API_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=./secrets/kalshi-prod.key

# --- Polymarket US (only needed for authenticated endpoints; public market data needs no key) ---
# Created at https://polymarket.us/developer. The secret key is shown once.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# --- Alerts (optional; stdout is always on) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# api.weather.gov requires an identifying User-Agent (contact info).
NWS_USER_AGENT=trading-system (you@example.com)
